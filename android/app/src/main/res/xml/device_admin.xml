<?xml version="1.0" encoding="utf-8"?>
<!-- Ao ficar ativo como administrador do dispositivo, o app não pode ser desinstalado
     sem antes desativar o admin (protegido por senha do responsável). -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <watch-login />
    </uses-policies>
</device-admin>
